{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (web - http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bulkyWebApp/bin/Debug/net11.0/bulkyWebApp.dll",
      "args": [],
      "cwd": "${workspaceFolder}/bulkyWebApp",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openUrl",
        "pattern": "\\bNow listening on:\\s+(http://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5091"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/bulkyWebApp/Views"
      }
    },
    {
      "name": ".NET Core Launch (web - https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bulkyWebApp/bin/Debug/net11.0/bulkyWebApp.dll",
      "args": [],
      "cwd": "${workspaceFolder}/bulkyWebApp",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openUrl",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/bulkyWebApp/Views"
      }
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
