@using BulkyBook.Models
@model Product

<div class="container-fluid py-4">
    <a asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Back to products
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>Create Product</h5>
            <p class="mb-0 small" style="color: #1DB954;">Add a new product to your catalog</p>
        </div>
        <div class="card-body p-4">

            <form method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold small"></label>
                    <input asp-for="Title" class="form-control" placeholder="Enter product title" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold small"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter description"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ISBN" class="form-label fw-semibold small"></label>
                        <input asp-for="ISBN" class="form-control" placeholder="Enter ISBN" />
                        <span asp-validation-for="ISBN" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Author" class="form-label fw-semibold small"></label>
                        <input asp-for="Author" class="form-control" placeholder="Enter author name" />
                        <span asp-validation-for="Author" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 col-lg-3 mb-3">
                        <label asp-for="ListPrice" class="form-label fw-semibold small"></label>
                        <input asp-for="ListPrice" class="form-control" placeholder="Enter list price" />
                        <span asp-validation-for="ListPrice" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-3">
                        <label asp-for="Price" class="form-label fw-semibold small"></label>
                        <input asp-for="Price" class="form-control" placeholder="Price for 1-50" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-3">
                        <label asp-for="Price50" class="form-label fw-semibold small"></label>
                        <input asp-for="Price50" class="form-control" placeholder="Price for 50+" />
                        <span asp-validation-for="Price50" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-3">
                        <label asp-for="Price100" class="form-label fw-semibold small"></label>
                        <input asp-for="Price100" class="form-control" placeholder="Price for 100+" />
                        <span asp-validation-for="Price100" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label fw-semibold small">Category</label>
                    <input asp-for="CategoryId" class="form-control" placeholder="Enter Category ID" />
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-accent fw-semibold">Create Product</button>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-light fw-medium">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}